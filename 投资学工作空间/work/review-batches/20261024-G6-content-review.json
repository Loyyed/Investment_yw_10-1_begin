  "contract": "第五次任务延伸合同_贵州茅台生产库存销售滞后验证.md",
  "status": "pending-human-content-review",
  "judgments": [
    {
      "id": "G6-N02",
      "claim": "长周期生产、贮存与质量控制能否形成有价值的供给",
      "proposed_interpretation": "长周期生产及贮存安排得到支持；库存的未来经济价值尚不能确认，不认定独有壁垒。",
      "support": [
        "R2016-05至少五年/多年份混合勾兑等工艺披露",
        "FY2016—2025半成品数量占比92.71%—96.66%，十年独立库存勾稽差额0吨",
        "五组t+5只是并列观察；16项k诊断均列n，不用最高r识别成熟期"
      ],
      "adverse_evidence": "FY2025成品库存增长39.47%，公司出货增长2.13%，是库龄、投放与需求核查线索；不能直接判积压或终端恶化。",
      "unknown": [
        "库龄及可售批次映射",
        "终端需求和同SKU净价",
        "未来可实现售价与损耗",
        "质量控制的独有性与增量回报"
      ],
      "refutation": "若成熟可售库存持续难以销售、净价/回款恶化或减值风险上升，应削弱有价值供给解释；需对应数据检验，当前不冒称这些事件已发生。",
      "state": "Interpretation待人工内容采纳，非新Fact"
    },
    {
      "id": "G6-N05",
      "claim": "增长是否需要提前形成基酒库存、产能和时间投入",
      "proposed_interpretation": "公司披露的建设、投产、预计释放和贮存安排支持增长存在前置产能与时间投入；具体项目投入到销售现金的贡献及高资本回报尚不能确认。",
      "support": [
        "B05明确2024/25新增设计能力、投产月份与不同预计释放年度；预计不等于实现",
        "B06固定资产净变动616,675,557.21元与报表一致，重要在建项目已列金额勾稽差额0元；转固是资产分类转换，不当现金付款",
        "2025购建长期资产现金3,127,594,916.41元、在建余额和项目投资各自按来源/期间/单位保留"
      ],
      "adverse_evidence": "第15页项目投资与第98页在建增加不能直接替换；重要项目转固与全部固定资产转固列示相差544,875,347.29元，尚未逐项解释。",
      "unknown": [
        "项目付款与工程确认、转固/折旧的完整调节",
        "维护与扩张投入拆分",
        "实际产能释放归因",
        "同批销售/收款及增量资本回报"
      ],
      "refutation": "若项目延迟、实际释放或销售现金显著低于可核原计划，或新增投入未产生可持续经济收益，应下调资本有效性判断；不把这些尚未核实情形当已发生。",
      "state": "Interpretation待人工内容采纳，非新Fact"
    }
  ],
