  "opinions": [
    {
      "id": "N07-annual-path",
      "kind": "Interpretation",
      "judgment": "2007—2011年选定会计利润公式/平均资本比率存在先升、连续回落、再跃升的年度波动，不能由两个端点的改善推出新增资本持续获得较好成熟回报。2008期初分类调整已按原披露桥接，账面营运资本变化不能直接当现金释放；正式经营ROIC及成熟增量回报仍未验证，不认定新增投入已被证实低效。",
      "alternative": "报表税率、利润项目、预付款经济用途、选定资本覆盖及投入成熟时间均可能影响代理。现有数据不足以把年度波动唯一归因新项目效率。",
      "refutation": "若同主体逐年投入、成熟时间与经营NOPAT/实体现金能够匹配，并在多组合理成熟窗口持续形成可核增量回报，且结论不依赖遗漏资本或税率假设，则应重评当前“未验证”的停止判断；反向若成熟投入持续不形成对应经营利润和现金，则削弱持续较好回报命题。当前两种检验均缺完整输入。",
      "stops": [
        "选择性资本不是完整经济资本，报表有效税率不是已核经营税率",
        "年度余额差并非累计现金再投资；四年端点跨度不证明逐笔成熟",
        "金融完整贡献/抵销、真实经营Capex和成熟投入映射仍不足"
      ]
    }
  ],
