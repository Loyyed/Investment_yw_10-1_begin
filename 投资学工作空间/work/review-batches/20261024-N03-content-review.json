  "status": "pending-human-content-review",
  "judgments": [
    {
      "id": "N03",
      "claim": "直销与i茅台提高公司确认的渠道收入和直接毛利后，是否提高渠道净贡献",
      "proposed_interpretation": "2025直销份额和正向结构效应得到支持，但渠道内毛利率下降超过结构效应，两渠道合计直接毛利率下降。费用率相关性具有时期敏感性；缺少渠道归属费用、回款和库存，净贡献是否提高仍Unknown。",
      "mechanism_hypothesis": "渠道迁移可能改变公司确认的收入/毛利份额，平台运营、履约投入和资金占用也可能变化；需同范围费用及资本/回款证据才能计算净贡献。",
      "observable_variables": [
        "按主营渠道披露的收入与营业成本",
        "公司销售费用及同范围公司营业收入",
        "FY2022自营+i茅台定义",
        "主营与附注的业务范围",
        "渠道费用、履约、回款与库存占用（目前不足）"
      ],
      "support": [
        "B07及旧有效组组成2016—2025十年主营渠道面板，所有原数有当前来源绑定",
        "2025直销份额50.0923%，较2024提高6.2247个百分点；两渠道合计直接毛利率变化−0.7837个百分点，结构效应+0.3934、渠道内毛利效应−1.1771，均为AgentCalculated",
        "B08核准公司费用率分子/分母；2025由3.2998%增至4.2961%，增加0.9963个百分点，不能全部归给某渠道",
        "整体相关n10/r−0.2533，2016—2021 n6/r−0.5815，2022—2025 n4/r+0.9485；窗口改变后符号不同，不识别直销费用因果",
        "2025附注减酒类主营的收入/成本差额分别63,517,327.14/86,377,431.32元；附注渠道收入与独立公司营业收入勾稽差额0元，主/附注保持分开"
      ],
      "alternative_explanations": "FY2022新平台并入渠道构成；产品组合、费用口径及业务范围共同变化均需区别。收入份额不等于同SKU终端成交效果，相关系数不分离其他经营变化。",
      "refutation": "若取得可比渠道费用、履约、回款及库存台账，显示增量毛利被新增费用和资本占用抵消，应否定净贡献提高命题；若可核完整净贡献持续增加且回款/资本占用支持，才可上调该判断。当前两种净贡献方向均未证实。",
      "unknown": [
        "直销/批发分别归属的完整费用和履约成本",
        "同SKU终端价格与真实动销",
        "渠道回款与库存/资本占用",
        "平台与线下自营的单独净贡献",
        "调整产品结构后的因果贡献"
      ],
      "state": "Interpretation待本人内容采纳，非新Fact"
    }
  ],
